# BUILD CONFIG
# ------------
# DOCKERFILE_FOLDER: subfolder containing the Dockerfile to build — either 'python' or 'r'
DOCKERFILE_FOLDER=python


# DATA CONFIG
# -----------
# Absolute paths to local directories to mount into the container.
# Docker requires absolute paths — use $PWD to reference the current directory.
# Example: INPUT_DIR=/home/user/data  or  INPUT_DIR=$PWD/sample_data

# INPUT_DIR: mounted as /input (read-only) inside the container
INPUT_DIR=$PWD/sample_data

# OUTPUT_DIR: mounted as /output (read-write) inside the container
OUTPUT_DIR=$PWD/output


# IMAGE CONFIG
# ------------
# Full image name to build and push.
#
# For the Synapse Docker Registry, use the format:
#   docker.synapse.org/PROJECT_ID/IMAGE_NAME:TAG
# where PROJECT_ID is the synID of ***your*** Synapse project.
#
# For other registries, use whatever format that registry requires.
IMAGE=docker.synapse.org/syn1234567/my_model:v1.0


# RESOURCE LIMITS (optional)
# ------------
# Match these to the constraints stated in the challenge, if any.
# Synapse defaults: 6g RAM, 6g memory-swap (no swap), 1G shm.
# MEMORY_LIMIT=6g
# MEMORY_SWAP_LIMIT=6g
# SHM_SIZE=1G
